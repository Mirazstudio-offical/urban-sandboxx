rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser() {
      let data = request.resource.data;
      return !('uid' in data) || data.uid == request.auth.uid;
    }

    function isValidFriendRequest() {
      let data = request.resource.data;
      return (data.senderUid == request.auth.uid || data.receiverUid == request.auth.uid);
    }

    function isValidFriendship() {
      let data = request.resource.data;
      return request.auth.uid in data.users;
    }

    function isValidInvite() {
      let data = request.resource.data;
      return (data.senderUid == request.auth.uid || data.receiverUid == request.auth.uid);
    }

    function isValidServer() {
      let data = request.resource.data;
      return data.hostUid == request.auth.uid;
    }
    
    function isValidSave() {
      let data = request.resource.data;
      return !('uid' in data) || data.uid == request.auth.uid;
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && isValidUser();
      allow delete: if isOwner(userId);
    }

    match /p2p_servers/{serverId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidServer();
      allow update: if isAuthenticated() && resource.data.hostUid == request.auth.uid && isValidServer();
      allow delete: if isAuthenticated() && resource.data.hostUid == request.auth.uid;
    }

    match /player_saves/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidSave();
      allow delete: if isOwner(userId);
    }

    match /friend_requests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid && isValidFriendRequest();
      allow update: if isAuthenticated() && (resource.data.receiverUid == request.auth.uid || resource.data.senderUid == request.auth.uid) && isValidFriendRequest();
      allow delete: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
    }

    match /friends/{friendId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.users) && isValidFriendship();
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.users);
    }

    match /invites/{inviteId} {
      allow read: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid && isValidInvite();
      allow update: if isAuthenticated() && (resource.data.receiverUid == request.auth.uid || resource.data.senderUid == request.auth.uid) && isValidInvite();
      allow delete: if isAuthenticated() && (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
    }
  }
}
