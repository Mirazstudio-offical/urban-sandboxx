{
  "entities": {
    "PrivateUserRecord": {
      "title": "Private User Record",
      "description": "Owner-only private user account document (may contain email or legacy profile data)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 64 },
        "nickname": { "type": "string", "maxLength": 32 },
        "avatarUrl": { "type": "string", "maxLength": 512 },
        "bio": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["online", "offline", "in_game"] },
        "currentRoomCode": { "type": "string", "maxLength": 64 },
        "stats": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "PublicProfile": {
      "title": "Public Player Profile",
      "description": "Publicly searchable non-PII player profile without email",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 64 },
        "displayNameLower": { "type": "string", "maxLength": 64 },
        "nickname": { "type": "string", "maxLength": 32 },
        "nicknameLower": { "type": "string", "maxLength": 32 },
        "avatarUrl": { "type": "string", "maxLength": 512 },
        "bio": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "enum": ["online", "offline", "in_game"] },
        "currentRoomCode": { "type": "string", "maxLength": 64 },
        "stats": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "nickname", "nicknameLower", "displayName", "displayNameLower"]
    },
    "FriendRequest": {
      "title": "Friend Request",
      "description": "Incoming and outgoing friend requests between players",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 64 },
        "receiverUid": { "type": "string", "maxLength": 128 },
        "receiverName": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "senderName", "receiverUid", "receiverName", "status"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Established friendship between two players",
      "type": "object",
      "properties": {
        "users": { "type": "array" },
        "user1": { "type": "object" },
        "user2": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["users", "user1", "user2"]
    },
    "WorldInvite": {
      "title": "World Invite",
      "description": "Direct world invitation sent to a friend",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 64 },
        "receiverUid": { "type": "string", "maxLength": 128 },
        "roomCode": { "type": "string", "maxLength": 64 },
        "serverName": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "senderName", "receiverUid", "roomCode", "serverName", "status"]
    },
    "P2PServerRoom": {
      "title": "P2P Server Room",
      "description": "Hosted P2P multiplayer room listed in the lobby",
      "type": "object",
      "properties": {
        "hostUid": { "type": "string", "maxLength": 128 },
        "hostName": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 80 },
        "peerId": { "type": "string", "maxLength": 64 },
        "maxPlayers": { "type": "number" },
        "currentPlayers": { "type": "number" },
        "mapName": { "type": "string", "maxLength": 64 },
        "gameMode": { "type": "string", "maxLength": 32 },
        "isPrivate": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "in_game", "closed"] },
        "trafficEnabled": { "type": "boolean" },
        "vehicleCount": { "type": "number" },
        "pedestrianCount": { "type": "number" },
        "hasPassword": { "type": "boolean" },
        "savePlayerData": { "type": "boolean" },
        "antiCheat": { "type": "string", "enum": ["none", "moderate", "strict"] },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hostUid", "hostName", "name", "peerId", "maxPlayers", "currentPlayers", "mapName", "gameMode", "isPrivate", "status"]
    },
    "PlayerCloudSave": {
      "title": "Player Cloud Save",
      "description": "Owner-only cloud progress snapshot",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "money": { "type": "number" },
        "health": { "type": "number" },
        "position": { "type": "object" },
        "inventory": { "type": "array" },
        "needs": { "type": "object" },
        "equippedItems": { "type": "object" },
        "version": { "type": "string", "maxLength": 32 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "money", "health", "position"]
    },
    "HostedServerBackup": {
      "title": "Hosted Server Backup",
      "description": "Owner-only persistent server snapshot containing settings, player accounts (salted password hashes), bans, mutes, player saves, and host world state",
      "type": "object",
      "properties": {
        "hostUid": { "type": "string", "maxLength": 128 },
        "hostName": { "type": "string", "maxLength": 64 },
        "roomCode": { "type": "string", "maxLength": 64 },
        "serverName": { "type": "string", "maxLength": 80 },
        "mapName": { "type": "string", "maxLength": 64 },
        "gameMode": { "type": "string", "maxLength": 32 },
        "access": { "type": "string", "enum": ["all", "code"] },
        "maxPlayers": { "type": "number" },
        "trafficEnabled": { "type": "boolean" },
        "vehicleCount": { "type": "number" },
        "pedestrianCount": { "type": "number" },
        "passwordRequired": { "type": "boolean" },
        "savePlayerData": { "type": "boolean" },
        "antiCheat": { "type": "string", "enum": ["none", "moderate", "strict"] },
        "accounts": { "type": "object" },
        "bans": { "type": "object" },
        "mutes": { "type": "object" },
        "playerSaves": { "type": "object" },
        "hostWorldState": { "type": "object" },
        "accountsCount": { "type": "number" },
        "bansCount": { "type": "number" },
        "savedPlayersCount": { "type": "number" },
        "lastSavedAt": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hostUid", "roomCode", "serverName", "mapName", "gameMode", "access", "maxPlayers", "trafficEnabled", "vehicleCount", "pedestrianCount", "passwordRequired", "savePlayerData", "antiCheat"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/PrivateUserRecord" },
      "description": "Owner-only private user account records (PII isolated)"
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Publicly searchable non-PII player profiles (strictly no email)"
    },
    "/friend_requests/{reqId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Friend requests between players"
    },
    "/friends/{friendId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Established friendships"
    },
    "/invites/{inviteId}": {
      "schema": { "$ref": "#/entities/WorldInvite" },
      "description": "Multiplayer room invites"
    },
    "/p2p_servers/{serverId}": {
      "schema": { "$ref": "#/entities/P2PServerRoom" },
      "description": "Active P2P server rooms with heartbeat timestamps"
    },
    "/player_saves/{userId}": {
      "schema": { "$ref": "#/entities/PlayerCloudSave" },
      "description": "Owner-only cloud save snapshots"
    },
    "/hosted_servers/{serverId}": {
      "schema": { "$ref": "#/entities/HostedServerBackup" },
      "description": "Owner-only persistent backups of hosted P2P servers (world, player saves, accounts, bans)"
    }
  }
}
